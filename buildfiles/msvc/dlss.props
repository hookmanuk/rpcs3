<?xml version="1.0" encoding="utf-8"?>
<!-- DLSS test (fork), imported by VKGSRender.vcxproj (its one line for all of this): VKDLSS's sources, and the NVIDIA DLSS
     SDK when the DLSS_SDK environment variable (or MSBuild property) names its folder (a clone or release of
     https://github.com/NVIDIA/DLSS: include\, lib\Windows_x86_64\). Without the SDK, RPCS3_DLSS only gives the motion
     vector debug views. -->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <ClInclude Include="$(MSBuildThisFileDirectory)..\..\rpcs3\Emu\RSX\VK\VKDLSS.h" />
    <ClCompile Include="$(MSBuildThisFileDirectory)..\..\rpcs3\Emu\RSX\VK\VKDLSS.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)..\..\rpcs3\Emu\RSX\VK\VKGSRenderDLSS.cpp" />
  </ItemGroup>
  <ItemDefinitionGroup Condition="'$(DLSS_SDK)' != ''">
    <ClCompile>
      <PreprocessorDefinitions>HAVE_DLSS;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(DLSS_SDK)\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <!-- VKGSRender is a static library: NGX's library goes into it, and so into rpcs3.exe.
         Release builds use the static CRT (/MT), Debug the dynamic debug CRT (/MDd). -->
    <Lib>
      <AdditionalLibraryDirectories>$(DLSS_SDK)\lib\Windows_x86_64\x64;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
      <AdditionalDependencies Condition="$(Configuration.Contains('Release'))">nvsdk_ngx_s.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalDependencies Condition="$(Configuration.Contains('Debug'))">nvsdk_ngx_d_dbg.lib;%(AdditionalDependencies)</AdditionalDependencies>
    </Lib>
  </ItemDefinitionGroup>
  <!-- The DLSS runtime goes next to rpcs3.exe (bin\). -->
  <Target Name="CopyDlssRuntime" AfterTargets="Build" Condition="'$(DLSS_SDK)' != '' And Exists('$(DLSS_SDK)\lib\Windows_x86_64\rel\nvngx_dlss.dll')">
    <Copy SourceFiles="$(DLSS_SDK)\lib\Windows_x86_64\rel\nvngx_dlss.dll" DestinationFolder="$(SolutionDir)bin\" SkipUnchangedFiles="true" />
  </Target>
</Project>
