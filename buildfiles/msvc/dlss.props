<?xml version="1.0" encoding="utf-8"?>
<!-- DLSS (fork), imported by VKGSRender.vcxproj (its one line for all of this): VKDLSS's and VKFrameGen's sources, and
     the DLSS plugin's build when the DLSS_SDK environment variable (or MSBuild property) names the NVIDIA DLSS SDK folder
     (a clone or release of https://github.com/NVIDIA/DLSS: include\, lib\Windows_x86_64\). -->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup>
    <ClInclude Include="$(MSBuildThisFileDirectory)..\..\rpcs3\Emu\RSX\VK\VKDLSS.h" />
    <ClCompile Include="$(MSBuildThisFileDirectory)..\..\rpcs3\Emu\RSX\VK\VKDLSS.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)..\..\rpcs3\Emu\RSX\VK\VKGSRenderDLSS.cpp" />
    <ClInclude Include="$(MSBuildThisFileDirectory)..\..\rpcs3\Emu\RSX\VK\VKFrameGen.h" />
    <ClCompile Include="$(MSBuildThisFileDirectory)..\..\rpcs3\Emu\RSX\VK\VKFrameGen.cpp" />
  </ItemGroup>
  <!-- NVIDIA DLSS is the optional plugin rpcs3_ngx.dll (rpcs3/ngx_plugin, MIT): rpcs3.exe links no NVIDIA code and loads
       the plugin at run time. With DLSS_SDK set, building VKGSRender also builds the plugin (and copies NVIDIA's runtime)
       into bin\. -->
  <Target Name="BuildNgxPlugin" AfterTargets="Build" Condition="'$(DLSS_SDK)' != '' And $(Configuration.Contains('Release'))">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\..\rpcs3\ngx_plugin\rpcs3_ngx.vcxproj" Properties="Configuration=Release;Platform=x64" />
  </Target>
</Project>
